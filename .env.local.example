# Copy to .env.local and fill in your keys. .env.local is gitignored.

# Deepgram speech-to-text (https://console.deepgram.com)
DEEPGRAM_API_KEY=

# Groq — used for answer evaluation (https://console.groq.com)
GROQ_API_KEY=

# Sarvam — speech-to-text for Malayalam, which Deepgram can't transcribe
# (https://dashboard.sarvam.ai)
SARVAM_API_KEY=
